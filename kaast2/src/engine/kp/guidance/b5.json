{
  "book": "b5",
  "rules": [
    {
      "id": "KP5-021+KP5-022+KP5-026+KP5-027",
      "topic": "Principles of judgement",
      "when": {
        "always": true
      },
      "text": "A planet gives the results of the houses its star lord holds: placed in the 12th but in the star of an 11th-house planet, it brings gains. Planets in a planet’s stars carry its houses more strongly than it does; with no such tenant, it gives them itself.",
      "tone": "info",
      "cite": "B5 pp. 189, 222–223, 244–245, 293"
    },
    {
      "id": "KP5-023",
      "topic": "Principles of judgement",
      "when": {
        "always": true
      },
      "text": "A house runs from its cusp to the next cusp, to the exact minute. Its lord is the lord of the sign the cusp falls in, wherever the larger part of the house lies.",
      "tone": "info",
      "cite": "B5 pp. 188, 207, 242"
    },
    {
      "id": "KP5-025",
      "topic": "Principles of judgement",
      "when": {
        "always": true
      },
      "text": "What a planet brings (the nature of its results) comes from the houses its star lord signifies. How and through whom (the source) comes from the houses the planet itself occupies and owns.",
      "tone": "info",
      "cite": "B5 pp. 301–304"
    },
