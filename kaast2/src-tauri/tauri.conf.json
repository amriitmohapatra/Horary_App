{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KAAST 2",
  "version": "../package.json",
  "identifier": "org.kararashram.kaast2",
  "build": {
    "frontendDist": "../dist-site",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "KAAST 2",
        "width": 1400,
        "height": 950,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval' 'unsafe-eval'",
        "style-src": "'self'",
        "font-src": "'self'",
        "img-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "worker-src": "'self'",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg"],
    "createUpdaterArtifacts": false,
    "publisher": "Kararashram",
    "copyright": "KAAST 2 contributors. Licensed under AGPL-3.0-only.",
    "license": "AGPL-3.0-only",
    "category": "Lifestyle",
    "shortDescription": "Offline Vedic astrology",
    "longDescription": "KAAST 2: offline Vedic astrology with Parashara's Light parity. Works without any internet connection.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "LICENSE.txt"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {}
}
